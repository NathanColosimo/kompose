{
  "name": "@kompose/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "db:check": "drizzle-kit check && drizzle-kit check --output json | jq -e '(.warnings // []) == []' > /dev/null",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose stop",
    "db:studio": "drizzle-kit studio --verbose --port 4984",
    "db:watch": "docker compose up",
    "redis:studio": "open -a 'Redis Insight'",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/sql-pg": "catalog:",
    "@kompose/env": "workspace:*",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "postgres": "^3.4.9",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@kompose/config": "workspace:*",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:"
  }
}
