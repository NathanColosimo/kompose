# Copy to .env.release (gitignored) for `bun run submit:prod:desktop`.

# Production API. Baked into the renderer (NEXT_PUBLIC_WEB_URL) and main
# process (MAIN_VITE_SERVER_URL) at build time.
KOMPOSE_RELEASE_SERVER_URL="https://kompose.dev"

# macOS notarization through an App Store Connect API key
# (App Store Connect > Users and Access > Integrations > Keys).
# Signing uses the "Developer ID Application" identity in your login keychain.
APPLE_API_KEY="/Users/you/keys/AuthKey_XXXXXXXXXX.p8"
APPLE_API_KEY_ID="XXXXXXXXXX"
APPLE_API_ISSUER="00000000-0000-0000-0000-000000000000"
