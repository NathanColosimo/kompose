{
  "name": "native",
  "version": "1.0.0",
  "private": true,
  "main": "./index.js",
  "scripts": {
    "android": "expo run:android",
    "build": "expo export --platform ios",
    "build:prod": "mkdir -p dist && rm -rf \"$HOME/.eas-build-cache/native\" && EAS_LOCAL_BUILD_SKIP_CLEANUP=1 EAS_LOCAL_BUILD_WORKINGDIR=\"$HOME/.eas-build-cache/native\" eas build -p ios --profile production --local --non-interactive --output ./dist/kompose.ipa",
    "dev": "expo start",
    "ios": "expo run:ios",
    "prebuild:native": "expo prebuild",
    "submit:prod": "eas submit -p ios --profile production --non-interactive --path ./dist/kompose.ipa --no-wait",
    "type-check": "tsc --noEmit",
    "update:preview": "eas update --channel preview --environment preview --platform ios --auto",
    "update:prod": "eas update --channel production --environment production --platform ios --auto",
    "web": "expo start --web"
  },
  "dependencies": {
    "@ai-sdk/react": "catalog:",
    "@better-auth/expo": "catalog:",
    "@expo/metro-runtime": "~57.0.16",
    "@kompose/ai": "workspace:*",
    "@kompose/api": "workspace:*",
    "@kompose/auth": "workspace:*",
    "@kompose/google-cal": "workspace:*",
    "@kompose/state": "workspace:*",
    "@orpc/client": "catalog:",
    "@rn-primitives/slot": "^1.5.2",
    "@tanstack/react-query": "catalog:",
    "ai": "catalog:",
    "better-auth": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "^57.0.24",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-navigation-bar": "~57.0.2",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.23",
    "expo-web-browser": "~57.0.3",
    "jotai": "catalog:",
    "lucide-react-native": "^1.47.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "^3.2.1",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "^5.9.1",
    "react-native-screens": "~4.27.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.12.1",
    "streamdown-rn": "^0.2.1",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "temporal-polyfill": "catalog:",
    "uniwind": "^1.12.0",
    "uuidv7": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "typescript": "catalog:"
  },
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-dom",
        "react-native-gesture-handler",
        "react-native-reanimated",
        "react-native-safe-area-context",
        "react-native-screens",
        "react-native-svg",
        "react-native-worklets",
        "typescript"
      ]
    }
  }
}
