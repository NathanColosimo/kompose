{
  "name": "native",
  "version": "1.0.0",
  "main": "./index.js",
  "scripts": {
    "dev": "expo start --clear",
    "build": "expo export --platform ios",
    "build:prod": "mkdir -p dist && rm -rf \"$HOME/.eas-build-cache/native\" && EAS_LOCAL_BUILD_SKIP_CLEANUP=1 EAS_LOCAL_BUILD_WORKINGDIR=\"$HOME/.eas-build-cache/native\" eas build -p ios --profile production --local --non-interactive --output ./dist/kompose.ipa",
    "submit:prod": "eas submit -p ios --profile production --non-interactive --path ./dist/kompose.ipa --wait",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:reset-simulator": "xcrun simctl shutdown all && xcrun simctl erase all && rm -rf ~/Library/Developer/Xcode/DerivedData && expo run:ios",
    "update:preview": "eas update --channel preview --environment preview --platform ios --auto",
    "update:prod": "eas update --channel production --environment production --platform ios --auto",
    "prebuild": "expo prebuild",
    "web": "expo start --web",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/react": "catalog:",
    "@better-auth/expo": "catalog:",
    "@expo/metro-runtime": "~57.0.8",
    "@expo/vector-icons": "^15.1.1",
    "@kompose/ai": "workspace:*",
    "@kompose/api": "workspace:*",
    "@kompose/auth": "workspace:*",
    "@kompose/google-cal": "workspace:*",
    "@kompose/state": "workspace:*",
    "@orpc/client": "catalog:",
    "@react-native-picker/picker": "2.11.4",
    "@rn-primitives/separator": "^1.5.2",
    "@rn-primitives/slot": "^1.5.2",
    "@tanstack/react-form": "^1.33.3",
    "@tanstack/react-query": "catalog:",
    "@types/node": "catalog:",
    "ai": "catalog:",
    "better-auth": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~57.0.9",
    "expo-apple-authentication": "~57.0.1",
    "expo-constants": "~57.0.8",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.10",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-picker": "~57.0.7",
    "expo-linking": "~57.0.4",
    "expo-navigation-bar": "~57.0.2",
    "expo-network": "~57.0.1",
    "expo-router": "~57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.11",
    "expo-web-browser": "~57.0.2",
    "jotai": "catalog:",
    "lucide-react-native": "^1.28.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "streamdown-rn": "^0.2.1",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
