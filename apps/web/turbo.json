{
  "extends": [
    "//"
  ],
  "tasks": {
    "build": {
      "env": [
        "DATABASE_URL",
        "REDIS_URL",
        "BETTER_AUTH_SECRET",
        "NEXT_PUBLIC_WEB_URL",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "GOOGLE_WEBHOOK_TOKEN",
        "GOOGLE_MAPS_API_KEY",
        "APPLE_CLIENT_ID",
        "APPLE_CLIENT_SECRET",
        "AXIOM_API_TOKEN",
        "AXIOM_DATASET",
        "APPLE_APP_BUNDLE_IDENTIFIER",
        "SPOTIFY_CLIENT_ID",
        "SPOTIFY_CLIENT_SECRET",
        "YOUTUBE_API_KEY",
        "WHOOP_CLIENT_ID",
        "WHOOP_CLIENT_SECRET"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "!.next/**"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ]
    },
    "type-check": {
      "outputs": [
        ".next/types/**",
        "tsconfig.tsbuildinfo"
      ]
    }
  }
}
