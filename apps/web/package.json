{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "bun ./node_modules/next/dist/bin/next build",
    "build:desktop": "bash ./scripts/build-desktop.sh",
    "build:prod": "(cd ../.. && vercel pull --yes --environment=production && vercel build --prod)",
    "build:prod:desktop": "bun run desktop:build:signed",
    "desktop:build": "tauri build --bundles dmg",
    "desktop:build:check-submission": "set -a; . ./.tauri.env; set +a && xcrun notarytool history --key \"$APPLE_API_KEY_PATH\" --key-id \"$APPLE_API_KEY\" --issuer \"$APPLE_API_ISSUER\"",
    "desktop:build:dev": "bash ./scripts/build-desktop-dev.sh",
    "desktop:build:signed": "set -a && . ./.tauri.env && set +a && (hdiutil info 2>/dev/null | grep -B20 kompose | grep -oE '/dev/disk[0-9]+$' | sort -u | xargs -I{} hdiutil detach {} -force 2>/dev/null; rm -f src-tauri/target/aarch64-apple-darwin/release/bundle/macos/rw.*.dmg 2>/dev/null; true) && bunx tauri build --bundles app,dmg --target aarch64-apple-darwin",
    "desktop:build:signed:universal": "set -a && . ./.tauri.env && set +a && bunx tauri build --bundles dmg --target universal-apple-darwin",
    "desktop:dev": "tauri dev",
    "desktop:release": "bash ./release-dmg.sh",
    "dev": "PORTLESS_PORT=443 PORTLESS_APP_PORT=3000 PORTLESS_TLD=dev PORTLESS_HTTPS=1 portless local.kompose bun ./node_modules/next/dist/bin/next dev",
    "devtools": "bunx @ai-sdk/devtools",
    "start": "bun ./node_modules/next/dist/bin/next start",
    "submit:prod": "(cd ../.. && vercel deploy --prebuilt --prod)",
    "submit:prod:desktop": "bun run desktop:release",
    "tauri": "tauri",
    "type-check": "bun ./node_modules/next/dist/bin/next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/react": "catalog:",
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/core": "^6.3.1",
    "@kompose/ai": "workspace:*",
    "@kompose/api": "workspace:*",
    "@kompose/auth": "workspace:*",
    "@kompose/env": "workspace:*",
    "@kompose/google-cal": "workspace:*",
    "@kompose/state": "workspace:*",
    "@opentelemetry/api": "catalog:",
    "@orpc/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/experimental-ratelimit": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-query": "catalog:",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-opener": "~2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2.4.4",
    "@tauri-apps/plugin-updater": "2.10.1",
    "@vercel/analytics": "^2.0.1",
    "ai": "catalog:",
    "better-auth": "catalog:",
    "chrono-node": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "effect": "catalog:",
    "fumadocs-core": "^16.14.3",
    "fumadocs-mdx": "^15.2.3",
    "fumadocs-ui": "^16.14.3",
    "jotai": "catalog:",
    "lucide-react": "^1.31.0",
    "next": "catalog:",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "catalog:",
    "react-day-picker": "^10.0.1",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "react-hotkeys-hook": "^5.3.2",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "streamdown": "^2.5.0",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "temporal-polyfill": "catalog:",
    "tokenlens": "^1.3.1",
    "use-stick-to-bottom": "^1.1.4",
    "uuidv7": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ai-sdk/devtools": "^1.0.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query-devtools": "catalog:",
    "@tauri-apps/cli": "^2.11.1",
    "@types/mdx": "^2.0.13",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:"
  }
}
