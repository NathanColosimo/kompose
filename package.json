{
  "name": "kompose",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "check": "biome check --write .",
    "type-check": "turbo run type-check",
    "dev": "turbo run dev db:studio",
    "build": "turbo run build",
    "build:prod": "turbo run type-check && turbo run build:prod build:prod:desktop --filter=web --filter=native",
    "build:prod:web": "turbo run type-check --filter=web... && turbo run build:prod build:prod:desktop --filter=web",
    "build:prod:native": "turbo run type-check --filter=native... && turbo run build:prod --filter=native",
    "submit:prod": "turbo run submit:prod submit:prod:desktop --filter=web --filter=native",
    "submit:prod:web": "turbo run submit:prod submit:prod:desktop --filter=web",
    "submit:prod:desktop": "turbo run submit:prod:desktop --filter=web",
    "submit:prod:native": "turbo run submit:prod --filter=native",
    "dev:native": "turbo run dev -F native",
    "dev:web": "turbo run dev devtools db:studio -F web -F @kompose/db",
    "portless:proxy": "sudo portless proxy start --https --tld dev",
    "knip": "knip",
    "db:push": "turbo run db:push -F @kompose/db",
    "db:studio": "turbo run db:studio -F @kompose/db",
    "db:generate": "turbo run db:generate -F @kompose/db",
    "db:migrate": "turbo run db:migrate -F @kompose/db",
    "db:start": "turbo run db:start -F @kompose/db",
    "db:watch": "turbo run db:watch -F @kompose/db",
    "db:stop": "turbo run db:stop -F @kompose/db",
    "db:down": "turbo run db:down -F @kompose/db"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@effect/language-service": "^0.86.1",
    "@types/bun": "^1.3.14",
    "knip": "^6.13.1",
    "turbo": "^2.9.14",
    "typescript": "catalog:",
    "ultracite": "^7.9.0"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@better-auth/expo": "^1.6.23",
      "@ai-sdk/openai": "^4.0.8",
      "@ai-sdk/react": "^4.0.16",
      "@orpc/client": "^1.14.6",
      "@orpc/contract": "^1.14.6",
      "@orpc/ai-sdk": "^1.14.6",
      "@orpc/experimental-ratelimit": "^1.14.6",
      "@orpc/openapi": "^1.14.6",
      "@orpc/server": "^1.14.6",
      "@orpc/zod": "^1.14.6",
      "@t3-oss/env-nextjs": "^0.13.11",
      "@tanstack/react-query": "^5.100.10",
      "@tanstack/react-query-devtools": "^5.100.10",
      "@types/node": "^25.6.2",
      "@types/react": "~19.2.17",
      "@types/react-dom": "~19.2.3",
      "better-auth": "^1.6.23",
      "ai": "^7.0.15",
      "dotenv": "^17.4.2",
      "drizzle-orm": "1.0.0-beta.23",
      "effect": "^3.21.2",
      "jotai": "^2.20.0",
      "jotai-family": "^1.0.2",
      "jotai-tanstack-query": "^0.11.0",
      "react-hook-form": "^7.81.0",
      "next": "^16.2.10",
      "react": "19.2.7",
      "react-dom": "19.2.7",
      "tailwindcss": "^4.3.0",
      "tailwind-merge": "^3.6.0",
      "temporal-polyfill": "^1.0.1",
      "typescript": "6.0.3",
      "resumable-stream": "^2.2.12",
      "uuidv7": "^1.2.1",
      "zod": "^4.4.3",
      "@effect/opentelemetry": "^0.63.0",
      "@opentelemetry/api": "^1.9.1",
      "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
      "@opentelemetry/instrumentation": "^0.220.0",
      "@opentelemetry/instrumentation-fetch": "^0.220.0",
      "@opentelemetry/sdk-metrics": "^2.9.0",
      "@opentelemetry/sdk-node": "^0.220.0",
      "@opentelemetry/sdk-trace-base": "^2.9.0",
      "@opentelemetry/sdk-trace-node": "^2.9.0",
      "@opentelemetry/resources": "^2.9.0",
      "@opentelemetry/sdk-trace-web": "^2.9.0",
      "@opentelemetry/semantic-conventions": "^1.41.1",
      "@orpc/otel": "^1.14.6"
    }
  },
  "dependencies": {
    "vercel": "^54.0.0"
  }
}
