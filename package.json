{
  "name": "kompose",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@better-auth/expo": "^1.6.27",
      "@ai-sdk/openai": "^4.0.41",
      "@ai-sdk/react": "^4.0.67",
      "@effect/platform": "^0.97.1",
      "@effect/sql": "^0.52.1",
      "@effect/sql-pg": "^0.53.0",
      "@orpc/client": "^1.15.0",
      "@orpc/contract": "^1.15.0",
      "@orpc/ai-sdk": "^1.15.0",
      "@orpc/experimental-ratelimit": "^1.15.0",
      "@orpc/openapi": "^1.15.0",
      "@orpc/server": "^1.15.0",
      "@orpc/zod": "^1.15.0",
      "@t3-oss/env-nextjs": "^0.13.11",
      "@tanstack/react-query": "^5.101.4",
      "@tanstack/react-query-devtools": "^5.101.4",
      "@types/node": "^26.2.0",
      "@types/react": "~19.2.18",
      "@types/react-dom": "~19.2.4",
      "better-auth": "^1.6.27",
      "ai": "^7.0.64",
      "dotenv": "^17.4.2",
      "drizzle-orm": "1.0.0-beta.23",
      "effect": "^3.22.1",
      "jotai": "^2.20.2",
      "jotai-family": "^1.1.0",
      "jotai-tanstack-query": "^0.11.0",
      "react-hook-form": "^7.85.0",
      "next": "16.3.0",
      "react": "19.2.8",
      "react-dom": "19.2.8",
      "tailwindcss": "^4.3.3",
      "tailwind-merge": "^3.6.0",
      "temporal-polyfill": "^1.0.3",
      "typescript": "7.0.2",
      "resumable-stream": "^2.2.12",
      "uuidv7": "^1.2.1",
      "zod": "^4.4.3",
      "@effect/opentelemetry": "^0.64.0",
      "@opentelemetry/api": "^1.9.1",
      "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
      "@opentelemetry/sdk-node": "^0.221.0",
      "@opentelemetry/sdk-trace-base": "^2.10.0",
      "@orpc/otel": "^1.15.0"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "build:prod": "turbo run build:prod --filter=web --filter=native",
    "build:prod:native": "turbo run build:prod --filter=native",
    "build:prod:web": "turbo run build:prod --filter=web",
    "db:down": "turbo run db:down -F @kompose/db",
    "db:generate": "turbo run db:generate -F @kompose/db",
    "db:migrate": "turbo run db:migrate -F @kompose/db",
    "db:push": "turbo run db:push -F @kompose/db",
    "db:start": "turbo run db:start -F @kompose/db",
    "db:stop": "turbo run db:stop -F @kompose/db",
    "db:studio": "turbo run db:studio -F @kompose/db",
    "db:watch": "turbo run db:watch -F @kompose/db",
    "dev": "turbo run dev db:studio",
    "dev:native": "turbo run dev -F native",
    "dev:web": "turbo run dev devtools db:studio -F web -F @kompose/db",
    "fix": "biome check --write .",
    "knip": "knip",
    "portless:proxy": "sudo portless proxy start --https --tld dev",
    "submit:prod": "turbo run submit:prod submit:prod:desktop --filter=web --filter=native",
    "submit:prod:desktop": "turbo run submit:prod:desktop --filter=web",
    "submit:prod:native": "turbo run submit:prod --filter=native",
    "submit:prod:web": "turbo run submit:prod submit:prod:desktop --filter=web",
    "type-check": "turbo run type-check"
  },
  "overrides": {
    "@effect/experimental": "0.61.1",
    "@effect/platform": "0.97.1",
    "@effect/sql": "0.52.1",
    "@effect/sql-pg": "0.53.0",
    "effect": "3.22.1",
    "expo-constants": "57.0.10",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.86.2",
    "react-native-screens": "4.27.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@effect/language-service": "^0.87.2",
    "@types/bun": "^1.3.14",
    "knip": "^6.32.2",
    "turbo": "^2.10.9",
    "typescript": "catalog:",
    "ultracite": "^7.10.3"
  },
  "packageManager": "bun@1.3.14",
  "patchedDependencies": {
    "expo-modules-jsi@57.0.4": "patches/expo-modules-jsi@57.0.4.patch"
  }
}
