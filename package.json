{
  "name": "kompose",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@better-auth/core": "1.7.12",
      "@better-auth/drizzle-adapter": "1.7.12",
      "@better-auth/electron": "1.7.12",
      "@better-auth/expo": "1.7.12",
      "@effect/opentelemetry": "4.0.5",
      "@effect/sql-pg": "4.0.5",
      "@opentelemetry/api": "^1.10.0",
      "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
      "@opentelemetry/sdk-node": "^0.300.0",
      "@opentelemetry/sdk-trace-base": "^2.12.0",
      "@orpc/client": "2.0.0-beta.46",
      "@orpc/contract": "2.0.0-beta.46",
      "@orpc/effect": "2.0.0-beta.46",
      "@orpc/ratelimit": "2.0.0-beta.46",
      "@orpc/openapi": "2.0.0-beta.46",
      "@orpc/opentelemetry": "2.0.0-beta.46",
      "@orpc/server": "2.0.0-beta.46",
      "@orpc/zod": "2.0.0-beta.46",
      "@t3-oss/env-nextjs": "^0.13.11",
      "@tanstack/query-core": "^5.104.5",
      "@tanstack/react-query": "^5.104.5",
      "@tanstack/react-query-devtools": "^5.104.5",
      "@types/node": "^26.6.5",
      "@types/react": "~19.3.0",
      "@types/react-dom": "~19.3.0",
      "better-auth": "1.7.12",
      "drizzle-kit": "1.0.0-rc.5",
      "drizzle-orm": "1.0.0-rc.5",
      "effect": "4.0.5",
      "jotai": "^3.0.1",
      "jotai-family": "^1.1.0",
      "jotai-tanstack-query": "^0.11.0",
      "next": "16.4.2",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "react-hook-form": "^7.90.0",
      "tailwind-merge": "^3.7.0",
      "tailwindcss": "^4.3.3",
      "temporal-polyfill": "^1.0.6",
      "typescript": "7.0.2",
      "uuidv7": "^1.2.1",
      "zod": "^4.6.7"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "build:desktop": "turbo run build --filter=@kompose/electron",
    "db:check": "bun run --cwd packages/db db:check",
    "db:down": "turbo run db:down -F @kompose/db",
    "db:generate": "turbo run db:generate -F @kompose/db",
    "db:migrate": "turbo run db:migrate -F @kompose/db",
    "db:push": "turbo run db:push -F @kompose/db",
    "db:start": "turbo run db:start -F @kompose/db",
    "db:stop": "turbo run db:stop -F @kompose/db",
    "db:studio": "turbo run db:studio -F @kompose/db",
    "db:watch": "turbo run db:watch -F @kompose/db",
    "dev": "turbo run dev db:studio",
    "dev:desktop": "turbo run dev --filter=@kompose/electron",
    "dev:native": "turbo run dev -F native",
    "dev:web": "turbo run dev db:studio -F web -F @kompose/db",
    "fix": "biome check --write .",
    "knip": "knip",
    "package:desktop": "turbo run package --filter=@kompose/electron",
    "portless:proxy": "sudo portless proxy start --https --tld dev",
    "type-check": "turbo run type-check"
  },
  "overrides": {
    "@effect/sql-pg": "4.0.5",
    "babel-preset-expo": "58.0.17",
    "effect": "4.0.5",
    "expo-constants": "58.0.13",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.0",
    "react-native-screens": "4.30.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@effect/language-service": "^0.87.5",
    "@types/bun": "^1.4.3",
    "knip": "^6.42.1",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "ultracite": "^8.0.1"
  },
  "packageManager": "bun@1.4.3",
  "trustedDependencies": [
    "electron"
  ]
}
